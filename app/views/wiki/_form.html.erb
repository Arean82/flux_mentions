<%
  settings = Setting.plugin_flux_mentions || {}
  symbol = settings['symbol'].presence || '@'
  group_enabled = settings['enable_group_mentions'] == '1' || settings['enable_group_mentions'] == true

  if @project
    users = @project.users.active.reject { |u| u.mail.blank? }
  else
    users = User.active.reject { |u| u.mail.blank? }
  end

  mention_items = users.map do |u|
    name = "#{u.firstname} #{u.lastname}".strip
    name = u.login if name.blank?
    { key: u.login, value: u.login, display: "#{name} (@#{u.login})", type: 'user' }
  end

  if group_enabled
    Group.all.each do |grp|
      name = grp.name
      key = grp.lastname.presence || name
      mention_items << { key: key, value: key, display: "#{name} [Group]", type: 'group' }
    end
  end
%>

<script>
(function() {
  function initWikiMentionTribute() {
    if (typeof Tribute === 'undefined') return;

    var mentionData = <%= raw mention_items.to_json %>;
    var mentionSymbol = <%= raw symbol.to_json %>;

    var tributed = new Tribute({
      values: mentionData,
      lookup: 'display',
      fillAttr: 'value',
      requireLeadingSpace: true,
      menuItemTemplate: function (item) {
        var badge = item.original.type === 'group' ? '<span style="float:right;font-size:10px;color:#92400e;background:#fef3c7;padding:1px 5px;border-radius:4px;margin-left:8px;">Group</span>' : '';
        return '<span>' + item.string + '</span>' + badge;
      },
      selectTemplate: function(item) {
        return mentionSymbol + item.original.value;
      },
      trigger: mentionSymbol
    });

    $('textarea#content_text, textarea.wiki-edit').each(function() {
      if (!this.__wikiTributeAttached) {
        tributed.attach(this);
        this.__wikiTributeAttached = true;
      }
    });
  }

  $(document).ready(initWikiMentionTribute);
  $(document).ajaxComplete(initWikiMentionTribute);
})();
</script>
